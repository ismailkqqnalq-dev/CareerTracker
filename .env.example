APP_ENV=development
DATABASE_URL=sqlite:///./careertracker.db
# PLACEHOLDER ONLY: replace locally with a random value of at least 32 bytes.
JWT_SECRET_KEY=development-placeholder-secret-key
# POSTGRES_PASSWORD=replace-with-a-strong-local-password  # placeholder only; replace before local Compose use
# Registration defaults on only when APP_ENV is explicitly development (case-insensitive).
# Missing, empty, or unknown APP_ENV values default to disabled.
# Uncomment to override the default: REGISTRATION_ENABLED=true
# Inbound email (optional): users forward recruiting emails to <random>@INBOUND_EMAIL_DOMAIN and the
# inbound provider calls POST /inbound/email with the X-Inbound-Secret header. Leave unset to disable.
# PLACEHOLDER ONLY: INBOUND_EMAIL_SECRET=replace-with-a-random-secret
# INBOUND_EMAIL_DOMAIN=gelen.example.com
# Outgoing email for "forgot password". In development the default is console (the email is
# printed to the server log, nothing is sent). In production set smtp, or reset stays disabled (503).
# EMAIL_BACKEND=smtp
# PUBLIC_APP_URL=https://careertracker.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# PLACEHOLDER ONLY: SMTP_PASSWORD=replace-with-the-provider-smtp-key
# SMTP_FROM=CareerTracker <bildirim@example.com>
# Refresh cookie is HTTPS-only unless APP_ENV is development.
# Uncomment to override the default: COOKIE_SECURE=true
# Process-local API rate limits (not shared across multiple server workers).
RATE_LIMIT_LOGIN_IP_PER_MINUTE=30
RATE_LIMIT_LOGIN_IP_EMAIL_PER_MINUTE=8
RATE_LIMIT_REGISTER_IP_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_IP_PER_HOUR=10
RATE_LIMIT_PASSWORD_RESET_EMAIL_PER_HOUR=3
RATE_LIMIT_OCR_PER_USER_PER_MINUTE=10
RATE_LIMIT_JOB_ANALYSIS_PER_USER_PER_MINUTE=10
RATE_LIMIT_SEMANTIC_CANDIDATES_PER_USER_PER_MINUTE=10
RATE_LIMIT_MAX_TRACKED_KEYS=10000
# Maximum opportunities per user; increase only if the deployment can support it.
MAX_OPPORTUNITIES_PER_USER=5000
# Empty by default: X-Forwarded-For is ignored unless the direct peer is trusted.
# Example: TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8
