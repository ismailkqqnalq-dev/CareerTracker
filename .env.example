APP_ENV=development
DATABASE_URL=sqlite:///./careertracker.db
# PLACEHOLDER ONLY: replace locally with a random value of at least 32 bytes.
JWT_SECRET_KEY=development-placeholder-secret-key
# POSTGRES_PASSWORD=replace-with-a-strong-local-password  # placeholder only; replace before local Compose use
# Registration defaults on only when APP_ENV is explicitly development (case-insensitive).
# Missing, empty, or unknown APP_ENV values default to disabled.
# Uncomment to override the default: REGISTRATION_ENABLED=true
# Process-local API rate limits (not shared across multiple server workers).
RATE_LIMIT_LOGIN_IP_PER_MINUTE=30
RATE_LIMIT_LOGIN_IP_EMAIL_PER_MINUTE=8
RATE_LIMIT_REGISTER_IP_PER_HOUR=5
RATE_LIMIT_OCR_PER_USER_PER_MINUTE=10
RATE_LIMIT_JOB_ANALYSIS_PER_USER_PER_MINUTE=10
RATE_LIMIT_SEMANTIC_CANDIDATES_PER_USER_PER_MINUTE=10
RATE_LIMIT_MAX_TRACKED_KEYS=10000
# Empty by default: X-Forwarded-For is ignored unless the direct peer is trusted.
# Example: TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8
